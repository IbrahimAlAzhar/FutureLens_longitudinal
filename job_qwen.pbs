#!/bin/bash
#PBS -N fwref_qwen
#PBS -l walltime=320:00:00
#PBS -l select=1:ncpus=8:mpiprocs=1:ngpus=1:mem=80gb
#PBS -j oe
set -euo pipefail
# Existing references only. No extraction or missing-reference fallback.
# qsub -v NUM_SAMPLES=10 job_qwen.pbs
# qsub -v NUM_SAMPLES=-1 job_qwen.pbs
export CODE_DIR=${CODE_DIR:-exp_curr_without_extract}
export DATA_DIR=${DATA_DIR:-futureScope/data}
export EMBEDDING_MODEL=${EMBEDDING_MODEL:-/all-MiniLM-L6-v2}
export NUM_SAMPLES=${NUM_SAMPLES:-10}
export METHODS=${METHODS:-"nmf lda bertopic"}
cd "$CODE_DIR"
exec bash "$CODE_DIR/run_job.sh" qwen all
